<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectoAdopt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".OnBoarding1"
            android:exported="true"
            android:label="@string/title_activity_on_boarding1"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Onboarding2"
            android:exported="false"
            android:label="@string/title_activity_onboarding2"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:label="@string/title_activity_dashboard"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.mascotas.MascotasActivity"
            android:exported="false"
            android:label="@string/title_activity_mascotas"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.refugios.RefugiosActivity"
            android:exported="false"
            android:label="@string/title_activity_refugios"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VoluntariadoActivity"
            android:exported="false"
            android:label="@string/title_activity_voluntariado"
            android:theme="@style/Theme.ProyectoAdopt"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>